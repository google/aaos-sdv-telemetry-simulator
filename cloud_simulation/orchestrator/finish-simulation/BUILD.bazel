# gazelle:prefix simulator.code/finish-simulation
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//build:gomock.bzl", "go_mock_library")

go_library(
    name = "finish-simulation",
    srcs = ["finisher.go"],
    importpath = "simulator.code/finish-simulation",
    visibility = ["//visibility:public"],
    deps = [
        "//cloud_simulation/orchestrator/finish-simulation/compute",
        "//cloud_simulation/orchestrator/finish-simulation/firestore",
        "@com_google_cloud_go_compute//apiv1/computepb",
        "@org_golang_google_api//googleapi",
    ],
)

go_test(
    name = "finish-simulation_test",
    srcs = ["finisher_test.go"],
    embed = [":finish-simulation"],
    deps = [
        ":mock",
        "//cloud_simulation/orchestrator/finish-simulation/firestore",
        "@com_google_cloud_go_compute//apiv1/computepb",
        "@org_golang_google_api//googleapi",
        "@org_golang_google_protobuf//proto",
        "@org_uber_go_mock//gomock",
    ],
)

go_mock_library(
    name = "mock",
    src = "finisher.go",
    importpath = "simulator.code/finish-simulation/mock",
    deps = [
        "//cloud_simulation/orchestrator/finish-simulation/firestore",
        "@com_google_cloud_go_compute//apiv1/computepb",
    ],
)
