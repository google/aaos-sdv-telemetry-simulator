        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "compute_test",
    srcs = ["client_test.go"],
    embed = [":compute"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@com_google_cloud_go_compute//apiv1",
        "@org_golang_google_api//option",
    ],
)
