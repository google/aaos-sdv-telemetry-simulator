load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "compute",
    srcs = ["client.go"],
    importpath = "simulator.code/orchestrator/internal/compute",
    visibility = ["//cloud_simulation/orchestrator:__subpackages__"],
    deps = [
        "@com_google_cloud_go_compute//apiv1",
        "@com_google_cloud_go_compute//apiv1/computepb",
        "@org_golang_google_api//googleapi",
