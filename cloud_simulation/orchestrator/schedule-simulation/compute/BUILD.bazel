load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "compute",
    srcs = [
        "builder.go",
        "client.go",
        "startup.go",
    ],
    importpath = "simulator.code/simulation-scheduler/compute",
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_cloud_go_compute//apiv1",
        "@com_google_cloud_go_compute//apiv1/computepb",
        "@org_golang_google_protobuf//proto",
    ],
)

alias(
    name = "update_golden",
    actual = "//cloud_simulation/orchestrator/schedule-simulation/compute/cmd/update_golden",
)

go_test(
    name = "compute_test",
    srcs = ["builder_test.go"],
    data = glob(["testdata/**"]),
    embed = [":compute"],
    deps = [
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)
