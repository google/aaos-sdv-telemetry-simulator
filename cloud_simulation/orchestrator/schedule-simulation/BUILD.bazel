# gazelle:prefix simulator.code/simulation-scheduler

load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//build:gomock.bzl", "go_mock_library")

go_library(
    name = "simulation-scheduler",
    srcs = ["scheduler.go"],
    importpath = "simulator.code/simulation-scheduler",
    visibility = ["//visibility:public"],
    deps = [
        "//cloud_simulation/orchestrator/schedule-simulation/compute",
        "//cloud_simulation/orchestrator/schedule-simulation/firestore",
        "//cloud_simulation/orchestrator/schedule-simulation/pubsub",
    ],
)

go_test(
    name = "simulation-scheduler_test",
    srcs = ["scheduler_test.go"],
    embed = [":simulation-scheduler"],
    deps = [
        ":mock",
        "//cloud_simulation/orchestrator/schedule-simulation/compute",
        "//cloud_simulation/orchestrator/schedule-simulation/pubsub",
        "@com_github_stretchr_testify//assert",
        "@org_uber_go_mock//gomock",
    ],
)

go_mock_library(
    name = "mock",
    src = "scheduler.go",
    importpath = "simulator.code/simulation-scheduler/mock",
    deps = [
        "//cloud_simulation/orchestrator/schedule-simulation/compute",
        "//cloud_simulation/orchestrator/schedule-simulation/pubsub",
    ],
)
