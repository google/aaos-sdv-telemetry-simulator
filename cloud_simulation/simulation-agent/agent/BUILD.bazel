# gazelle:prefix simulator.code/simulation-agent

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//build:gomock.bzl", "go_mock_library")

go_binary(
    name = "agent",
    embed = [":simulation-agent_lib"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "simulation-agent_lib",
    srcs = [
        "main.go",
        "run_simulation.go",
    ],
    importpath = "simulator.code/simulation-agent",
    visibility = ["//visibility:private"],
    deps = [
        "//cloud_simulation/simulation-agent/agent/adb",
        "//cloud_simulation/simulation-agent/agent/finisher",
        "//cloud_simulation/simulation-agent/agent/storage",
    ],
)

go_test(
    name = "simulation-agent_test",
    srcs = ["main_test.go"],
    data = [
        "//cloud_simulation/simulation-agent/agent/testdata/metrics_config:metrics_configs",
        "//cloud_simulation/simulation-agent/agent/testdata/publisher_config:publisher_configs",
    ],
    embed = [":simulation-agent_lib"],
    deps = [
        ":mock",
        "//cloud_simulation/simulation-agent/agent/finisher",
        "@com_github_stretchr_testify//assert",
        "@org_uber_go_mock//gomock",
    ],
)

go_mock_library(
    name = "mock",
    src = "main.go",
    importpath = "simulator.code/simulation-agent/mock",
    deps = [
        "//cloud_simulation/simulation-agent/agent/finisher",
    ],
)
