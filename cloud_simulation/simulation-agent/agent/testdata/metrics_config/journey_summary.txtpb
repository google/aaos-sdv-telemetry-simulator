uuid: "f26924b9-4cf7-4787-b4c1-fa8193f70172"
version: 1

descriptor_protos {
    message_type {
        name: "Report"
        field {
            type: TYPE_DOUBLE
            name: "average_speed"
            number: 1
        }
        field {
            type: TYPE_INT32
            name: "max_speed"
            number: 2
        }
        field {
            type: TYPE_INT32
            name: "num_software_crashes"
            number: 3
        }
    }

    message_type {
        name: "MaxSpeed"
        field {
            type: TYPE_INT32
            name: "max_speed"
            number: 1
        }
    }

    message_type {
        name: "AvgSpeed"
        field {
            type: TYPE_DOUBLE
            name: "avg_speed"
            number: 1
        }
    }

    message_type {
        name: "ErrorCount"
        field {
            type: TYPE_INT32
            name: "error_count"
            number: 1
        }
    }
}

triggers {
    name: "new_speed_data"
    data_trigger {
        source_name: "speed_publisher"
    }
}

triggers {
    name: "new_error_report_publisher_data"
    data_trigger {
        source_name: "error_report_publisher"
    }
}

triggers {
    name: "every_minute"
    periodic_trigger {
        interval {
            seconds: 60
            nanos: 0
        }
    }
}

sources {
    name: "speed_publisher"
    data_source {
        source_identifier: "SimulationSpeedPublisher"
    }
}

sources {
    name: "error_report_publisher"
    data_source {
        source_identifier: "SimulationErrorPublisher"
    }
}

sources {
    name: "max_speed_publisher"
    aggregator {
        trigger_names: "new_speed_data"
        reset_on_get: false
        message_builder {
            message_type: ".MaxSpeed"
            field_assignments {
                field_name: "max_speed"
                max_aggregation {
                    expression_node_index: 0
                 }
            }
        }
    }
}

sources {
    name: "avg_speed_publisher"
    aggregator {
        trigger_names: "new_speed_data"
        reset_on_get: false
        message_builder {
            message_type: ".AvgSpeed"
            field_assignments {
                field_name: "avg_speed"
                avg_aggregation {
                    expression_node_index: 0
                 }
            }
        }
    }
}

sources {
    name: "error_count_publisher"
    aggregator {
        trigger_names: "new_error_report_publisher_data"
        reset_on_get: false
        message_builder {
            message_type: ".ErrorCount"
            field_assignments {
                field_name: "error_count"
                count_aggregation {}
            }
        }
    }
}

# index 0
expression_nodes {
    field_leaf_node {
        source_name: "speed_publisher"
        field_names: "speed"
      }
}

# index 1
expression_nodes {
    field_leaf_node {
        source_name: "max_speed_publisher"
        field_names: "max_speed"
      }
}

# index 2
expression_nodes {
    field_leaf_node {
        source_name: "avg_speed_publisher"
        field_names: "avg_speed"
      }
}

# index 3
expression_nodes {
    field_leaf_node {
        source_name: "error_count_publisher"
        field_names: "error_count"
      }
}

metrics_report_configs {
    name: "journey_summary"
    trigger_names: "every_minute"
    report_incomplete: true

    message_builder {
        message_type: ".Report"
        field_assignments {
            field_name: "num_software_crashes"
            no_aggregation {
                expression_node_index: 3
            }
        }
        field_assignments {
            field_name: "average_speed"
            no_aggregation {
                expression_node_index: 2
            }
        }
        field_assignments {
            field_name: "max_speed"
            no_aggregation {
                expression_node_index: 1
            }
        }
    }
}
