# Split pipeline architecture: The CI/CD pipeline builds the simulation
# agent image in two distinct stages. Both stages must run to get a
# complete image.
#
# 1. Dockerfile.base: Cuttlefish orchestration base + SDV build artifacts
#    (host package & image zip). These artifacts must be present in the
#    build context, fetched by the pipeline. Tagged per SDV build so it
#    can be reused.
# 2. Dockerfile.agent: A thin layer on top of a base image that adds the
#    pre-compiled agent binary. Prerequisite: agent-binary must be built
#    beforehand by the pipeline; the FROM argument selects the base tag.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG AGENT_GIT_SHA=""

COPY agent-binary /agent/agent-binary
RUN chmod +x /agent/agent-binary
LABEL agent.git_sha="${AGENT_GIT_SHA}"

ENTRYPOINT ["/agent/agent-binary"]
