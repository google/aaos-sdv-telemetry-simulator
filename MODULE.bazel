"""
Android Automotive Software Defined Vehicle Cloud Telemetry Simulation
"""

module(
    name = "com_googlesource_sdv_cloud_telemetry_simulation",
    version = "0.3.0",
)

bazel_dep(
    name = "gazelle",
    version = "0.44.0",
)
bazel_dep(
    name = "googleapis",
    version = "0.0.0-20250703-f9d6fe4a",
)
bazel_dep(
    name = "googleapis-go",
    version = "1.0.0",
)
bazel_dep(
    name = "rules_go",
    version = "0.59.0",
)
bazel_dep(
    name = "rules_pkg",
    version = "1.1.0",
)
bazel_dep(
    name = "rules_proto",
    version = "7.1.0",
)
bazel_dep(
    name = "rules_python",
    version = "1.5.1",
)
bazel_dep(
    name = "rules_shellcheck",
    version = "0.3.3",
)
bazel_dep(
    name = "protobuf",
    version = "29.3",
    repo_name = "protobuf_src",
)
bazel_dep(
    name = "bazel_skylib",
    version = "1.8.1",
)
bazel_dep(
    name = "rules_shell",
    version = "0.5.0",
)
bazel_dep(
    name = "aspect_bazel_lib",
    version = "2.20.0",
)
bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.2.0.2",
)

# Allows to execute as root (required for Cloud Build)
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.13",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.nogo(nogo = "//:my_nogo")
go_sdk.download(version = "1.26.8")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:go.work")

# All *direct* Go dependencies of the module have to be listed explicitly.
use_repo(
    go_deps,
    "com_github_bazelbuild_buildtools",
    "com_github_google_uuid",
    "com_github_stretchr_testify",
    "com_google_cloud_go_compute",
    "com_google_cloud_go_compute_metadata",
    "com_google_cloud_go_firestore",
    "com_google_cloud_go_functions",
    "com_google_cloud_go_pubsub",
    "com_google_cloud_go_storage",
    "org_golang_google_api",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_uber_go_mock",
)
